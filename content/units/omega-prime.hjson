type: mech
name: Omega-Prime
description: "The supreme core unit of the Giga-Core. Features hyper-advanced construction beams and a dual-purpose plasma pulse weapon. Its quantum-shielded hull allows it to maintain structural integrity under extreme fire."

# Physicals - Much beefier than Gamma
speed: 3.5
accel: 0.1
drag: 0.05
health: 8500
armor:60
hitSize: 12
engineSize: 4
engineOffset: 8
itemCapacity: 300

# The "Giga" Stats
buildSpeed: 3.5       # Still far above Gamma, but no longer replaces all builder pressure.
mineSpeed: 4.0        # Fast enough to feel elite without collapsing ore progression.
mineTier: 4           # Leaves Tau-tier extraction to dedicated late-game infrastructure.
buildRange: 220       # Safe, but not map-dominating.

# Capabilities
mineItems: [hardened-carbide, quantum-alloy, lead, copper, coal]
flying: true
isCounted: false      # Doesn't take up unit cap

weapons: [
  {
    name: omega-pulse
    x: 5
    y: 2
    reload: 15
    alternate: true
    shootSound: lasershoot
    bullet: {
      type: LaserBoltType
      damage: 45
      speed: 6
      lifetime: 40
      frontColor: b892ff
      backColor: 98ffd9
      healPercent: 8
      collidesTeam: true
    }
  }
]
