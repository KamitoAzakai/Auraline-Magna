name: "Tectonic Drill"
type: Drill
description: "A heavy-duty industrial drill. Uses Tau-forged resonators to induce localized tectonic shifts, shattering ore veins instantly. Requires constant cooling."
size: 3
tier: 8
drillTime: 16
health: 3200
itemCapacity: 120
hardnessDrillMultiplier: 8

consumes: {
  power: 8.5
  liquids: [
    # High-tier cooling keeps the resonators from self-welding.
    ionic-refrigerant/0.35
  ]
  items: [
    kinetic-crystal/1
  ]
}

drawer: {
  type: DrawMulti
  drawers: [
    {
      # The main tectonic thumper animation
      type: DrawPistons
      sinMag: 1.5
      sinScl: 5
    }
    {
      # High-speed rotation for the drill head
      type: DrawBlurSpin
      suffix: "-rotator"
      rotateSpeed: 12
    }
    {
      type: DrawDefault
    }
    {
      # Seafoam glow that pulses with the drilling speed
      type: DrawGlowRegion
      suffix: "-top"
      color: d0fff4
    }
    {
      # The Modern Pulse Effect
      type: DrawPulseShape
      # Square shape to match the 3x3 drill footprint
      square: true
      # Sampled from the Quantum Alloy's glowing core
      color: d0fff4
      # Speed and intensity of the pulse
      timeScl: 40
      mag: 1.2
    }
  ]
}

requirements: [
  titanium/500
  crystalline-silicon/350
  hardened-carbide/650
  kinetic-crystal/180
  quantum-alloy/120
  thorium/450
]

category: production
research: kinetic-crystal
