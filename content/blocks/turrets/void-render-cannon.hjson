name: Void-Render Cannon
type: ItemTurret
description: "A triple-nozzle siege platform with adaptive firing modes. Processes Quantum Alloy for armor-piercing, Tau-forged Alloy for wide-area carpet bombardment, and Volatile Isotopes for total annihilation."
size: 4
health: 4200
armor: 15
category: turret

reload: 24
range: 430
recoil: 4
shake: 5
inaccuracy: 0
shootSound: shootBig

shoot: {
  type: ShootBarrel
  barrels: [
    -12, 4, 0
    0, 6, 0
    12, 4, 0
  ]
}

consumes: {
  liquid: {
    liquid: plasma-flux
    amount: 0.35
  }
}

ammoTypes: {
  quantum-alloy: {
    type: BasicBulletType
    damage: 900
    speed: 15
    width: 12
    height: 18
    lifetime: 29
    pierce: true
    pierceCap: 5
    armorPiercing: 35
    frontColor: 98ffd9
    backColor: 5ebda3
    trailColor: 98ffd9
    trailWidth: 4
    trailLength: 15
    hitEffect: blastExplosion
    despawnEffect: flakExplosion
  }

  tau-forged-quantum-alloy: {
    type: BasicBulletType
    damage: 4200
    speed: 12
    width: 14
    height: 20
    lifetime: 36
    # To handle multiple shots properly within ammoTypes:
    shoot: {
      shots: 3
      shotDelay: 2
    }
    splashDamage: 1200
    splashDamageRadius: 48
    frontColor: b892ff
    backColor: 311e4d
    trailColor: b892ff
    trailWidth: 5
    trailLength: 20
    # FIXED: scudExplosion -> scatheExplosion
    hitEffect: {
      type: MultiEffect
      effects: [massiveExplosion, scatheExplosion]
    }
  }

  volatile-isotope: {
    type: BasicBulletType
    damage: 12000
    speed: 18
    width: 18
    height: 30
    lifetime: 24
    splashDamage: 8500
    splashDamageRadius: 56
    frontColor: ffffff
    backColor: ff6b38
    trailColor: ff6b38
    trailWidth: 6
    trailLength: 30
    # FIXED: nuclearExplosion -> reactorExplosion
    hitEffect: {
      type: MultiEffect
      effects: [instBomb, reactorExplosion]
    }
    despawnEffect: sapExplosion
  }
}

requirements: [
  hardened-carbide/900
  quantum-alloy/500
  enhanced-quantum-alloy/250
  tau-forged-thorium/350
  crystalline-silicon/450
]

research: auraline-apex
